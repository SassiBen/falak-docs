# Où vit l'index (ChromaDB persistant)
FALAKDOCS_INDEX=./index
# Embeddings : toujours calculés en local par Ollama
OLLAMA_URL=http://localhost:11434
FALAKDOCS_EMBED_MODEL=bge-m3
# Génération : "ollama" (local) ou "claude" (API Anthropic)
FALAKDOCS_PROVIDER=ollama
FALAKDOCS_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_S
FALAKDOCS_CLAUDE_MODEL=claude-opus-5-5
FALAKDOCS_CLAUDE_EFFORT=medium
# ANTHROPIC_API_KEY=...
FALAKDOCS_API_KEY=change-me
